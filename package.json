{
	"name": "obsidian-sample-plugin",
	"version": "1.0.7",
	"description": "This is a sample plugin for Obsidian (https://obsidian.md)",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "bun esbuild.config.mjs",
		"build": "bun esbuild.config.mjs production",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"lint": "eslint .",
		"test": "vitest run",
		"ci": "bun run build && bun run typecheck && bun run lint && bun run test",
		"release": "bun run scripts/release.ts"
	},
	"keywords": [],
	"author": "Beomsu Koh",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "^26.6.5",
		"builtin-modules": "5.4.0",
		"esbuild": "0.28.2",
		"eslint": "^10.13.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "17.13.0",
		"jiti": "2.7.0",
		"obsidian": "^1.14.4",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
